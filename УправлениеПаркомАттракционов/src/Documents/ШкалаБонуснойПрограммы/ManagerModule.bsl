#Область ПрограммныйИнтерфейс

// Перепроводит все проведённые документы шкалы бонусной программы.
// Изменения вносятся транзакционно.
Процедура ПерепровестиВсеШкалы() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ШкалаБонуснойПрограммы.Ссылка
		|ИЗ
		|	Документ.ШкалаБонуснойПрограммы КАК ШкалаБонуснойПрограммы
		|ГДЕ
		|	ШкалаБонуснойПрограммы.Проведен = ИСТИНА";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ДокОбъект = Выборка.Ссылка.ПолучитьОбъект();
		ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

