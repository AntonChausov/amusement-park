#Область ПрограммныйИнтерфейс

Процедура ЗаполнитьПоказателиФилиалов() Экспорт
	
	Если Не ЗначениеЗаполнено(НачалоМесяца) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не указано начало месяца";
		Сообщение.УстановитьДанные(ЭтотОбъект);
		Сообщение.Поле = "НачалоМесяца";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	
	КонецМесяца = КонецМесяца(НачалоМесяца);
	
	Показатели.Очистить();
	
	ЗапросФилиалы = Новый Запрос;
	ЗапросФилиалы.Текст = 
		"ВЫБРАТЬ
		|	Филиалы.Ссылка
		|ИЗ
		|	Справочник.Филиалы КАК Филиалы
		|ГДЕ
		|	НЕ Филиалы.ПометкаУдаления";
	
	ВыборкаФилиалы = ЗапросФилиалы.Выполнить().Выбрать();
	
	Пока ВыборкаФилиалы.Следующий() Цикл
		
		ТекущийФилиал = ВыборкаФилиалы.Ссылка;
		
		ЗапросДоход = Новый Запрос;
		ЗапросДоход.Текст = 
			"ВЫБРАТЬ
			|	ПродажиОбороты.СуммаОборот КАК Сумма
			|ИЗ
			|	РегистрНакопления.Продажи.Обороты(&НачалоПериода, &КонецПериода,, Филиал = &Филиал) КАК ПродажиОбороты";
		ЗапросДоход.УстановитьПараметр("НачалоПериода", НачалоМесяца);
		ЗапросДоход.УстановитьПараметр("КонецПериода", КонецМесяца);
		ЗапросДоход.УстановитьПараметр("Филиал", ТекущийФилиал);
		
		ВыборкаДоход = ЗапросДоход.Выполнить().Выбрать();
		
		Доход = 0;
		Если ВыборкаДоход.Следующий() Тогда
			Доход = ВыборкаДоход.Сумма;
		КонецЕсли;
		
		Расход = Доход * 0.3;
		
		Если Доход = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = Показатели.Добавить();
		НоваяСтрока.Филиал = ТекущийФилиал;
		НоваяСтрока.Доход = Доход;
		НоваяСтрока.Расход = Расход;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
